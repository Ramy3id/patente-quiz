{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dashboard", "destination": "/interactive_pages/dashboard.html" },
    { "source": "/zero-mistake", "destination": "/interactive_pages/zero-mistake.html" },
    { "source": "/cheat-sheet", "destination": "/interactive_pages/cheat-sheet.html" },
    { "source": "/decodificatore-incroci", "destination": "/interactive_pages/decodificatore-incroci.html" },
    { "source": "/laboratorio-numeri", "destination": "/interactive_pages/laboratorio-numeri.html" },
    { "source": "/primo-soccorso", "destination": "/interactive_pages/primo-soccorso.html" },
    { "source": "/flashcards", "destination": "/interactive_pages/flashcards.html" },
    { "source": "/scheda-esame", "destination": "/interactive_pages/scheda-esame.html" },
    { "source": "/parole-spia", "destination": "/interactive_pages/parole-spia.html" },
    { "source": "/piano-studio", "destination": "/interactive_pages/piano-studio.html" },
    { "source": "/traps_and_games", "destination": "/interactive_pages/traps_and_games.html" },
    { "source": "/trucchi-esame", "destination": "/interactive_pages/trucchi-esame.html" },
    { "source": "/allenamento-capitolo", "destination": "/interactive_pages/allenamento-capitolo.html" },
    { "source": "/simulatore", "destination": "/Simulatore_Esame.html" },
    { "source": "/Simulatore_Esame", "destination": "/Simulatore_Esame.html" },
    { "source": "/studio", "destination": "/Studio_Quiz_Patente.html" },
    { "source": "/Studio_Quiz_Patente", "destination": "/Studio_Quiz_Patente.html" },
    { "source": "/capitoli", "destination": "/Capitoli_Divisi/index.html" },
    { "source": "/Capitoli_Divisi", "destination": "/Capitoli_Divisi/index.html" },
    { "source": "/privacy", "destination": "/interactive_pages/index.html" },
    { "source": "/terms", "destination": "/interactive_pages/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

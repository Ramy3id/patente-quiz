rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // قفل الوصول الافتراضي لأي مستند مجهول
    match /{document=**} {
      allow read, write: if false;
    }

    // تأمين مجموعة المستخدمين: كل طالب يمكنه قراءة وتعديل مستنده الخاص فقط
    match /users/{userId} {
      // السماح بإنشاء الملف الشخصي عند التسجيل إذا كان الـ UID يطابق المستخدم الموثق
      allow create: if request.auth != null && request.auth.uid == userId;

      // السماح بالقراءة والتعديل والحذف لصاحب الحساب فقط
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // حماية بيانات التقدم والأخطاء والامتحانات الفرعية
      match /userData/{subDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
